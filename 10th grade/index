<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Die Physik-Heldenreise – Epic Edition</title>
<style>
:root{--bg:#070b17;--panel:#11182b;--line:#536087;--gold:#e9c467;--red:#d74755}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f7f5ff;font-family:Georgia,serif}button{font:inherit;cursor:pointer}.screen{display:none;min-height:100vh}.screen.active{display:flex}
#start,#end{align-items:center;justify-content:center;padding:24px;background:radial-gradient(circle at 50% 10%,#3c4b7b,#080c19 68%)}.panel{width:min(1200px,96vw);background:#0e1629ed;border:1px solid #69749a;border-radius:28px;padding:30px;box-shadow:0 30px 100px #000b}.logo{text-align:center;font-size:clamp(2rem,6vw,4.8rem);font-weight:900}.sub{text-align:center;color:#bbc4df;font-family:system-ui}
.heroes{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:28px 0}.hero{padding:14px;border:2px solid #3e496e;border-radius:20px;background:linear-gradient(160deg,#202c4e,#11172a);transition:.2s}.hero:hover,.hero.selected{border-color:var(--gold);transform:translateY(-5px)}.avatar{height:190px;display:flex;align-items:center;justify-content:center}.avatar svg{height:185px;max-width:175px;filter:drop-shadow(0 16px 8px #0009)}.hero h2{text-align:center}.hero p{text-align:center;color:#b8c0da;min-height:42px}.gender button{width:100%;padding:11px;border:1px solid #56628e;background:#252f51;color:white;border-radius:11px}.gender button.sel{background:#9a712f}
.primary{border:0;border-radius:12px;padding:14px 25px;color:#fff;background:linear-gradient(135deg,#6d5bc3,#aa6bc5);font-weight:700}
#game{padding:14px;justify-content:center}.wrap{width:min(1400px,100%);display:grid;grid-template-columns:250px 1fr;grid-template-rows:auto 1fr auto;gap:12px}.hud{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:15px;background:#10172b;border:1px solid var(--line);border-radius:16px;padding:10px 15px;font-family:system-ui}.mini{display:flex;align-items:center;gap:10px}.miniAvatar{font-size:2.5rem}.bars{width:min(360px,40vw)}.label{display:flex;justify-content:space-between;font-size:.8rem;color:#c0c7de}.bar{height:17px;background:#30364b;border:1px solid #59627c;border-radius:20px;overflow:hidden}.bar div{height:100%;background:linear-gradient(90deg,#bb3045,#ef9b42);transition:.4s}.bar.shake{animation:shake .45s}.xp{height:8px;background:#293451;border-radius:10px;overflow:hidden}.xp div{height:100%;background:linear-gradient(90deg,#5e7fff,#ad6de8);width:0;transition:.4s}.tags{display:flex;gap:5px;flex-wrap:wrap}.tag{font-size:.72rem;border:1px solid #74603a;background:#30291f;color:#f0d58d;border-radius:999px;padding:4px 8px}
.sidebar{background:#0f1628;border:1px solid var(--line);border-radius:18px;padding:14px;font-family:system-ui}.sidebar h3{margin-top:0;color:var(--gold)}.map{height:440px;position:relative;overflow:hidden;border-radius:14px;border:1px solid #3e4d67;background:linear-gradient(160deg,#17263c,#101d28)}.map:after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,transparent 43%,#7b6747 44% 45%,transparent 46%);opacity:.75}.node{position:absolute;z-index:2;width:45px;height:45px;border-radius:50%;display:grid;place-items:center;background:#293452;border:2px solid #68759c}.node.current{background:#986f2d;border-color:#f1cd6d;box-shadow:0 0 28px #efc75d}.node.done{background:#315e45;border-color:#67d493}.n1{left:8%;bottom:10%}.n2{left:34%;top:44%}.n3{right:20%;top:28%}.n4{right:8%;bottom:12%}
.main{position:relative;min-height:440px;overflow:hidden;border:1px solid #56617f;border-radius:22px;background:linear-gradient(#17213e 0 54%,#1b3829 54%);box-shadow:inset 0 -100px 100px #0007}.moon{position:absolute;right:12%;top:11%;width:70px;height:70px;border-radius:50%;background:#ebe4c9;box-shadow:0 0 40px #ebe4c977}.mount{position:absolute;bottom:32%;left:-5%;width:110%;height:42%;background:#121a31;clip-path:polygon(0 100%,12% 40%,23% 65%,37% 12%,49% 70%,61% 25%,76% 68%,89% 18%,100% 57%,100% 100%)}.ground{position:absolute;bottom:0;width:100%;height:49%;background:linear-gradient(170deg,#23462f,#0b2118)}.story{position:absolute;z-index:6;left:20px;top:20px;width:min(710px,calc(100% - 40px));background:#090e1dec;border:1px solid #68749a;border-radius:16px;padding:15px}.story h2{margin:0 0 5px;color:var(--gold)}.story p{margin:0;line-height:1.5;color:#e4e7f5}.actor{position:absolute;z-index:5;bottom:34px;font-size:8.2rem;filter:drop-shadow(0 18px 9px #0009)}
.trollFace{width:150px;height:150px;position:relative;display:flex;align-items:center;justify-content:center;
font-size:7rem;filter:drop-shadow(0 20px 10px #000);transform:scaleX(1.08)}
.trollFace:before{content:"";position:absolute;width:118px;height:100px;border-radius:48% 48% 42% 42%;
background:linear-gradient(#68702e,#303617);border:5px solid #171b0c;z-index:-1}
.trollFace:after{content:"☠";position:absolute;color:#e7d8c0;font-size:3.2rem;bottom:4px;left:51px;
text-shadow:0 2px 3px #000;opacity:.95}
.player{left:13%}.enemy{right:9%}.swordAttack{animation:sword .7s}.magicAttack{animation:magic .8s}.hit{animation:hit .45s}.die{animation:die 1s forwards}
@keyframes sword{45%{transform:translateX(250px) rotate(8deg)}}@keyframes magic{40%{transform:translateX(80px) scale(1.15);filter:drop-shadow(0 0 35px #a87cff)}}@keyframes hit{25%{transform:translateX(22px) rotate(-9deg);filter:brightness(2)}}@keyframes die{to{opacity:0;transform:scale(.1) translateY(100px)}}@keyframes shake{20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-6px)}80%{transform:translateX(5px)}}
.controls{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;background:#10172b;border:1px solid #414d72;border-radius:15px;padding:9px}.action{border:1px solid #56628e;background:#252f51;color:#fff;border-radius:11px;padding:11px}.action:hover{background:#36436d}
.modal{display:none;position:fixed;z-index:20;inset:0;background:#02040ddd;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.question{width:min(800px,96vw);background:#141c34;border:1px solid #737ea9;border-radius:22px;padding:24px}.badge{color:var(--gold);text-transform:uppercase;letter-spacing:.12em;font:700 .8rem system-ui}.answers{display:grid;gap:9px;margin-top:18px}.answers button{padding:14px;text-align:left;border:1px solid #505d84;background:#232e51;color:#fff;border-radius:12px}.feedback{display:none;margin-top:13px;padding:12px;border-radius:10px;background:#202a48}.feedback.show{display:block}.toast{position:fixed;z-index:30;top:18px;left:50%;transform:translate(-50%,-100px);background:#17233f;border:1px solid #6b789f;border-radius:12px;padding:11px 18px;transition:.3s;font-family:system-ui}.toast.show{transform:translate(-50%,0)}
@media(max-width:900px){.heroes{grid-template-columns:repeat(2,1fr)}.wrap{grid-template-columns:1fr}.sidebar{display:none}}@media(max-width:600px){.heroes{grid-template-columns:1fr}.actor{font-size:5.5rem}.bars{width:100%}.hud{flex-wrap:wrap}}
</style></head><body>

<section id="start" class="screen active"><div class="panel"><div class="logo">⚔️ DIE PHYSIK-HELDENREISE ⚡</div><p class="sub">Wähle deinen Helden. Bestehe die Prüfungen. Besiege den Drachen.</p>
<div class="heroes">

<div class="hero"><div class="avatar"><svg viewBox="0 0 160 190"><circle cx="80" cy="55" r="27" fill="#c88761"/><path fill="#34271f" d="M53 53q7-35 30-29 25-4 28 30l-12-13-8 8-10-10-9 10z"/><path fill="#9ba7bd" d="M57 55h46v18H57z"/><path fill="#6d432e" d="M45 84h70v70H45z"/><path fill="#b8c4d4" d="M39 91l-25 18 10 39 30-9z"/><path fill="#d9b04f" d="M112 91l15 8-6 69-9-3z"/><path fill="#cdd5df" d="M117 98l7 3 5-52 8 1-6 61-12 1z"/></svg></div><h2>Ritter</h2><p>Starker Nahkämpfer mit Schild und Schwert.</p><div class="gender"><button data-kind="Ritter">⚔️ Ritter wählen</button></div></div>

<div class="hero"><div class="avatar"><svg viewBox="0 0 160 190"><circle cx="80" cy="55" r="27" fill="#c98763"/><path fill="#4b211e" d="M51 66Q35 25 80 17q45 8 29 49l-15-20-12 12-12-12z"/><path fill="#9ba7bd" d="M53 55h54v17H53z"/><path fill="#583c66" d="M43 84h74v75H43z"/><path fill="#b8c4d4" d="M43 91L15 110l14 38 28-12z"/><path fill="#d7b04f" d="M117 86l7 8-13 74-8-2z"/><path fill="#d7dce4" d="M116 91l8 3 6-52 8 1-7 61-13 2z"/></svg></div><h2>Kriegerin</h2><p>Bewegliche Kämpferin mit Schild und Schwert.</p><div class="gender"><button data-kind="Kriegerin">🛡️ Kriegerin wählen</button></div></div>

<div class="hero"><div class="avatar"><svg viewBox="0 0 160 190"><circle cx="80" cy="55" r="25" fill="#bd7d5c"/><path fill="#25203b" d="M45 55L80 8l35 47z"/><path fill="#d6c2a1" d="M51 77h58v13H51z"/><path fill="#3c487c" d="M43 85h74l15 75H28z"/><path fill="#a87b42" d="M118 88l8 2-8 76-9-1z"/><circle cx="121" cy="87" r="8" fill="#9b6fff"/></svg></div><h2>Zauberer</h2><p>Beherrscht Energie, Elektrizität und Magie.</p><div class="gender"><button data-kind="Zauberer">🔮 Zauberer wählen</button></div></div>

<div class="hero"><div class="avatar"><svg viewBox="0 0 160 190"><circle cx="80" cy="55" r="25" fill="#c98a68"/><path fill="#9a385e" d="M50 65Q34 27 80 14q46 13 30 51l-14-19-16 11-13-11z"/><path fill="#f0d6bd" d="M51 77h58v13H51z"/><path fill="#633b78" d="M43 85h74l15 75H28z"/><path fill="#a87b42" d="M118 88l8 2-8 76-9-1z"/><circle cx="121" cy="87" r="8" fill="#71b7ff"/></svg></div><h2>Magierin</h2><p>Beherrscht Energie, Elektrizität und Magie.</p><div class="gender"><button data-kind="Magierin">✨ Magierin wählen</button></div></div>
</div>
<p id="chosen" class="sub" style="color:#e7bd62">Wähle eine Figur.</p><div style="text-align:center"><button id="startBtn" class="primary" disabled>🌲 Heldenreise beginnen</button></div></div></section>

<section id="game" class="screen"><div class="wrap"><div class="hud"><div class="mini"><span id="miniAvatar" class="miniAvatar">⚔️</span><div><b id="heroName"></b><div class="tags" id="tags"></div></div></div><div class="bars"><div class="label"><span>❤️ LEBEN</span><b id="hpText">100 / 100</b></div><div id="hpbar" class="bar"><div></div></div><div class="label"><span>⭐ XP</span><b id="xpText">0 / 100</b></div><div class="xp"><div id="xpbar"></div></div></div></div>
<aside class="sidebar"><h3>🗺️ Heldenreise</h3><div class="map"><div id="n1" class="node n1">🌲</div><div id="n2" class="node n2">👹</div><div id="n3" class="node n3">⚔️</div><div id="n4" class="node n4">🐉</div></div><p style="color:#aeb7d4">Wald → Troll → Schmiede → Drachenberg</p></aside>
<main class="main"><div class="moon"></div><div class="mount"></div><div class="ground"></div><div class="story"><h2 id="title"></h2><p id="story"></p></div><div id="player" class="actor player">⚔️</div><div id="enemy" class="actor enemy"></div></main>
<div id="controls" class="controls"></div></div></section>

<div id="modal" class="modal"><div class="question"><div class="badge">⚡ Physikprüfung</div><h2 id="qtitle"></h2><p id="qtext"></p><div id="answers" class="answers"></div><div id="feedback" class="feedback"></div></div></div><div id="toast" class="toast"></div>
<section id="end" class="screen"><div class="panel" style="text-align:center"><div style="font-size:8rem">🏆🐉</div><h1>Der Drache ist besiegt!</h1><p id="endText" class="sub"></p><button class="primary" onclick="location.reload()">↻ Neue Heldenreise</button></div></section>

<script>
const $=id=>document.getElementById(id);let H={kind:"",hp:100,xp:0,items:[]},P=null;
const Q={
shield:["Die Schmiede des Schildes","Ein Körper mit 6 kg Masse wird auf der Erde gehalten. Wie groß ist seine Gewichtskraft? (g ≈ 10 N/kg)",["6 N","16 N","60 N","600 N"],2,"F_G = m · g = 60 N.",20],
staff:["Der Stab der Energie","Welche Formel beschreibt die elektrische Leistung?",["P = U · I","P = m · g","P = s · t","P = F · s"],0,"P = U · I.",20],
t1:["Der Troll der Bewegung","Der Troll läuft gleichförmig mit 3 m/s. Welche Strecke legt er in 8 s zurück?",["11 m","24 m","32 m","48 m"],1,"s = v · t = 24 m.",25],
t2:["Die Keule des Trolls","Der Troll beschleunigt von 2 m/s auf 8 m/s in 3 s. Wie groß ist seine mittlere Beschleunigung?",["2 m/s²","3 m/s²","6 m/s²","10 m/s²"],0,"a = Δv/Δt = 2 m/s².",30],
bridge:["Die Brücke der Geschwindigkeit","Du legst 120 m in 20 s zurück. Wie groß ist deine Durchschnittsgeschwindigkeit?",["4 m/s","6 m/s","12 m/s","140 m/s"],1,"v = s/t = 6 m/s.",20],
sword:["Die Klinge der Kraft","Du übst 200 N auf 0,02 m² aus. Wie groß ist der Druck?",["100 Pa","1 000 Pa","10 000 Pa","100 000 Pa"],2,"p = F/A = 10 000 Pa.",25],
cloak:["Der Mantel der Energie","Ein Körper mit 2 kg wird 5 m hochgehoben. Wie groß ist seine Lageenergie? (g ≈ 10 N/kg)",["10 J","25 J","100 J","500 J"],2,"E_pot = mgh = 100 J.",25],
d1:["Der Feuerball","Ein Feuerball mit 0,5 kg fliegt mit 20 m/s. Welche kinetische Energie besitzt er?",["50 J","100 J","200 J","400 J"],1,"E_kin = ½mv² = 100 J.",40],
d2:["Der Drachenblitz","Am Drachenamulett liegen 12 V an. Es fließen 2 A. Welche Leistung wird umgesetzt?",["6 W","10 W","24 W","120 W"],2,"P = U·I = 24 W.",45],
d3:["Die letzte Prüfung","Ein Gerät nimmt 600 J Energie auf und gibt 450 J Nutzenergie ab. Wie groß ist der Wirkungsgrad?",["25 %","50 %","75 %","90 %"],2,"η = 450/600 = 75 %.",50]
};
document.querySelectorAll(".gender button").forEach(b=>b.onclick=()=>{H.kind=b.dataset.kind;document.querySelectorAll(".hero").forEach(x=>x.classList.remove("selected"));b.closest(".hero").classList.add("selected");document.querySelectorAll(".gender button").forEach(x=>x.classList.remove("sel"));b.classList.add("sel");$("chosen").textContent="Gewählt: "+H.kind;$("startBtn").disabled=false});
$("startBtn").onclick=startGame;
function startGame(){$("start").classList.remove("active");$("game").classList.add("active");H={...H,hp:100,xp:0,items:[]};let a={Ritter:"🧑‍⚔️",Kriegerin:"👩‍🦰⚔️",Zauberer:"🧙‍♂️",Magierin:"👩‍🦳🪄"}[H.kind];$("miniAvatar").textContent=a;$("player").textContent=a;$("heroName").textContent=H.kind;update();intro()}
function update(){$("hpText").textContent=`${H.hp} / 100`;$("hpbar").firstElementChild.style.width=H.hp+"%";$("xpText").textContent=`${H.xp} / 100`;$("xpbar").style.width=Math.min(H.xp,100)+"%";$("tags").innerHTML=H.items.map(x=>`<span class="tag">✨ ${x}</span>`).join("")||'<span class="tag">Keine Upgrades</span>'}
function scene(t,s,e=""){
 $("title").textContent=t;$("story").textContent=s;
 $("enemy").className="actor enemy";
 if(e==="TROLL"){
   $("enemy").innerHTML='<div class="trollFace">👹</div>';
 }else{$("enemy").textContent=e}
 if(H.kind==="Kriegerin") $("player").textContent="👩‍🦰⚔️";
 else if(H.kind==="Magierin") $("player").textContent="👩‍🦳🪄";
}
function buttons(a){$("controls").innerHTML="";a.forEach(x=>{let b=document.createElement("button");b.className="action";b.textContent=x[0];b.onclick=x[1];$("controls").appendChild(b)})}
function map(n){for(let i=1;i<=4;i++){$("n"+i).classList.toggle("current",i===n);if(i<n)$("n"+i).classList.add("done")}}
function intro(){map(1);scene("Das Tor zur Heldenreise","Vor dir liegt ein uralter Wald. Im Nebel bewegt sich etwas Großes. Du hörst eine schwere Keule über den Boden schleifen.");buttons([["🌲 In den Wald",troll]])}
function ask(k,yes,no){P={k,yes,no};let q=Q[k];$("qtitle").textContent=q[0];$("qtext").textContent=q[1];$("feedback").className="feedback";$("answers").innerHTML=q[2].map((x,i)=>`<button onclick="answer(${i})">${String.fromCharCode(65+i)}) ${x}</button>`).join("");$("modal").classList.add("open")}
function answer(i){let q=Q[P.k],ok=i===q[3];document.querySelectorAll("#answers button").forEach(b=>b.disabled=true);$("feedback").textContent=ok?"✅ Richtig! "+q[4]:"❌ Falsch. "+q[4];$("feedback").className="feedback show";if(ok){H.xp=Math.min(100,H.xp+q[5]);update()}setTimeout(()=>{$("modal").classList.remove("open");(ok?P.yes:P.no)()},1000)}
function sound(f,d,type="sine"){try{let C=window.AudioContext||window.webkitAudioContext,c=new C,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.value=f;g.gain.value=.05;o.connect(g);g.connect(c.destination);o.start();o.stop(c.currentTime+d)}catch(e){}}
function damage(n){H.hp=Math.max(1,H.hp-n);update();$("hpbar").classList.remove("shake");void $("hpbar").offsetWidth;$("hpbar").classList.add("shake");sound(100,.35,"sawtooth");$("toast").textContent=`❤️ −${n} Lebenspunkte`;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),900)}
function attack(){let magic=["Zauberer","Magierin"].includes(H.kind);$("player").className="actor player "+(magic?"magicAttack":"swordAttack");$("enemy").classList.add("hit");sound(magic?520:180,.25,magic?"sine":"square");setTimeout(()=>$("player").className="actor player",750)}
function troll(){map(2);scene("Der Troll","Ein blutrünstiger Troll tritt aus dem Nebel. Blut klebt an seiner Keule, seine Zähne sind gefletscht. Kleine Narben und dunkle Wunden bedecken sein Gesicht. Er will dich nicht verhandeln lassen. Nur Physik kann ihn stoppen.","TROLL");buttons([["⚔️ Erste Prüfung",()=>ask("t1",troll2,()=>{damage(15);troll2()})]])}
function troll2(){buttons([["⚔️ Zweite Prüfung",()=>ask("t2",trollWin,()=>{damage(20);trollWin()})]])}
function trollWin(){attack();setTimeout(bridge,850)}
function bridge(){map(3);scene("Die verlassene Brücke","Hinter dem Troll wartet eine düstere Schlucht. Ein geheimnisvoller Wächter verlangt eine Bewegungsberechnung, bevor du weiter darfst.","🧝‍♂️");buttons([["🧠 Rätsel lösen",()=>ask("bridge",forge,()=>{damage(15);forge()})]])}
function forge(){scene("Die verborgene Schmiede","Das Feuer der Schmiede lodert. Hier kannst du dein erstes Ausrüstungsstück verbessern.");let k=["Ritter","Kriegerin"].includes(H.kind)?"shield":"staff",i=k==="shield"?"Schild":"Stab";buttons([[`✨ ${i} upgraden`,()=>ask(k,()=>{H.items.push("verstärkter "+i);update();forgeNext()},forgeNext)],["⏭️ Überspringen",forgeNext]])}
function forgeNext(){scene("Der Drachenberg","Vor dem Eingang der Drachenhöhle liegt die letzte Schmiede. Du kannst dein Schwert oder deinen Mantel verbessern.","🐲");buttons([["🔥 Letzte Vorbereitung",finalForge]])}
function finalForge(){let k=["Ritter","Kriegerin"].includes(H.kind)?"sword":"cloak",i=k==="sword"?"Schwert":"Mantel";buttons([[`✨ ${i} verbessern`,()=>ask(k,()=>{H.items.push("verbesserter "+i);update();dragon()},dragon)],["⏭️ Ohne Upgrade",dragon]])}
function dragon(){map(4);scene("Der Drache","Der Drache erhebt sich aus der Feuerhöhle. Drei schwere Prüfungen stehen dir bevor. Der Boden bebt.","🐉");buttons([["⚔️ Erste Drachenprüfung",()=>ask("d1",d2,wrong)]])}
function d2(){attack();setTimeout(()=>buttons([["⚡ Zweite Drachenprüfung",()=>ask("d2",d3,wrong)]]),550)}
function d3(){buttons([["🔥 Letzte Drachenprüfung",()=>ask("d3",win,wrong)]])}
function wrong(){damage(25);buttons([["⚔️ Weiterkämpfen",d3]])}
function win(){attack();setTimeout(()=>{$("enemy").classList.add("die");scene("Der Drache fällt!","Ein letzter Schrei hallt durch das Gebirge. Du hast deine Physikkenntnisse bewiesen und die Heldenreise vollendet.");sound(720,.5);setTimeout(end,1000)},750)}
function end(){$("game").classList.remove("active");$("end").classList.add("active");$("endText").textContent=`${H.kind}: Du hast den Drachen besiegt! XP: ${H.xp}/100. Upgrades: ${H.items.join(", ")||"keine"}.`}
</script></body></html>
