<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Kartuschenbrenner – Begriffe zuordnen</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  margin:0; font-family:Arial,Helvetica,sans-serif; background:#f3f5f7;
  color:#20252b; min-height:100vh; overflow-x:hidden;
}
header{
  background:#fff; border-bottom:1px solid #ddd; padding:18px 22px 14px;
  position:sticky; top:0; z-index:10;
}
h1{margin:0 0 6px;font-size:clamp(22px,3.5vw,34px)}
.subtitle{color:#666;font-size:clamp(15px,2vw,19px)}
.wrap{max-width:1200px;margin:auto;padding:18px}
.progress{
  background:#fff;border-radius:14px;padding:12px 16px;margin-bottom:16px;
  box-shadow:0 2px 8px #00000010;display:flex;align-items:center;gap:14px;
}
.bar{height:12px;background:#e7e9ec;border-radius:20px;flex:1;overflow:hidden}
.fill{height:100%;width:0%;background:#2878d4;transition:.3s}
#status{font-weight:bold;white-space:nowrap}
.layout{display:grid;grid-template-columns:1fr 1.25fr;gap:18px}
.panel{
 background:#fff;border-radius:16px;padding:16px;box-shadow:0 3px 12px #00000012;
}
.panel h2{font-size:21px;margin:0 0 12px}
.term-list{display:grid;gap:11px}
.term{
 background:#eaf2ff;border:2px solid #8fb8ee;border-radius:12px;padding:15px;
 font-size:clamp(17px,2.2vw,21px);font-weight:600;cursor:grab;
 touch-action:none;user-select:none;
 min-height:58px;display:flex;align-items:center;
}
.term.selected{outline:4px solid #ffd35a;background:#fff7d7}
.term.used{opacity:.28;cursor:default}
.drop-list{display:grid;gap:11px}
.drop{
 min-height:72px;border:2px dashed #aeb5bd;border-radius:12px;padding:10px;
 display:flex;align-items:center;gap:10px;transition:.15s;background:#fafbfc;
}
.drop.over{border-color:#2878d4;background:#eaf3ff}
.drop.correct{border-style:solid;border-color:#36a269;background:#eaf8f0}
.drop.wrong{border-style:solid;border-color:#d84d4d;background:#fff0f0;animation:shake .25s}
.desc{flex:1;font-size:clamp(15px,1.9vw,18px);line-height:1.3}
.answer{
 min-width:150px;max-width:42%;padding:10px;border-radius:9px;
 background:#2878d4;color:white;font-weight:bold;text-align:center;
 font-size:clamp(14px,1.7vw,17px)
}
.empty{color:#8a9199;font-style:italic;font-size:14px}
.buttons{display:flex;gap:10px;justify-content:center;margin-top:18px;flex-wrap:wrap}
button{
 border:0;border-radius:11px;padding:13px 20px;font-size:17px;font-weight:bold;
 cursor:pointer;touch-action:manipulation;
}
#reset{background:#e5e8ec;color:#222}
#new{background:#2878d4;color:white}
#feedback{text-align:center;font-size:19px;font-weight:bold;min-height:28px;margin-top:10px}
@keyframes shake{25%{transform:translateX(-5px)}50%{transform:translateX(5px)}75%{transform:translateX(-4px)}}
@media(max-width:800px){
 .layout{grid-template-columns:1fr}
 .panel:first-child{order:1}.panel:last-child{order:2}
 .term-list{grid-template-columns:1fr 1fr}
 .answer{min-width:115px}
}
@media(max-width:520px){
 .wrap{padding:10px}.term-list{grid-template-columns:1fr}
 .drop{min-height:88px;align-items:stretch;flex-direction:column;justify-content:center}
 .answer{max-width:100%;width:100%}
}
</style>
</head>
<body>
<header>
  <h1>Die Arbeit mit dem Kartuschenbrenner</h1>
  <div class="subtitle">Ordne die Begriffe den passenden Beschreibungen zu.</div>
</header>

<div class="wrap">
  <div class="progress">
    <span id="status">0 / 8 richtig</span>
    <div class="bar"><div class="fill" id="fill"></div></div>
  </div>

  <div class="layout">
    <section class="panel">
      <h2>Begriffe</h2>
      <div class="term-list" id="terms"></div>
      <div class="buttons">
        <button id="reset">Zurücksetzen</button>
        <button id="new">Neu mischen</button>
      </div>
    </section>

    <section class="panel">
      <h2>Beschreibungen</h2>
      <div class="drop-list" id="drops"></div>
      <div id="feedback"></div>
    </section>
  </div>
</div>

<script>
const data = [
 {t:"Kartusche", d:"Enthält das Brenngas und wird am Brenner befestigt."},
 {t:"Gasregler", d:"Mit ihm wird die Menge des austretenden Gases eingestellt."},
 {t:"Luftzufuhr", d:"Hier wird die Luftmenge geregelt, die mit dem Gas vermischt wird."},
 {t:"Brennerrohr", d:"In diesem Bereich strömt das Gas-Luft-Gemisch nach oben."},
 {t:"Flammenbild", d:"Anhand von Farbe und Form kann man erkennen, ob die Verbrennung geeignet ist."},
 {t:"Sicherheitsventil", d:"Sorgt dafür, dass der Brenngasstrom bei einer Störung begrenzt bzw. unterbrochen werden kann."},
 {t:"Zündvorrichtung", d:"Damit wird das ausströmende Gas entzündet."},
 {t:"Arbeitsflamme", d:"Die geeignete Flamme für viele Experimente: heiß und mit ausreichender Luftzufuhr."}
];

const termsEl=document.getElementById("terms");
const dropsEl=document.getElementById("drops");
const feedback=document.getElementById("feedback");
let selected=null, correct=0;

function shuffle(a){
 let x=[...a];
 for(let i=x.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}
 return x;
}

function render(){
 correct=0; selected=null; feedback.textContent="";
 termsEl.innerHTML=""; dropsEl.innerHTML="";
 shuffle(data).forEach((item,i)=>{
   const el=document.createElement("div");
   el.className="term"; el.textContent=item.t; el.dataset.term=item.t;
   el.addEventListener("pointerdown",e=>startDrag(e,el));
   el.addEventListener("click",()=>selectTerm(el));
   termsEl.appendChild(el);
 });
 shuffle(data).forEach(item=>{
   const drop=document.createElement("div");
   drop.className="drop"; drop.dataset.answer=item.t;
   drop.innerHTML=`<div class="desc">${item.d}</div><div class="answer empty">Begriff hier ablegen</div>`;
   drop.addEventListener("pointerover",()=>{if(selected)drop.classList.add("over")});
   drop.addEventListener("pointerout",()=>drop.classList.remove("over"));
   drop.addEventListener("pointerup",()=>{if(selected){drop.classList.remove("over");place(selected,drop)}});
   drop.addEventListener("click",()=>{if(selected)place(selected,drop)});
   dropsEl.appendChild(drop);
 });
 update();
}

function selectTerm(el){
 if(el.classList.contains("used")) return;
 document.querySelectorAll(".term.selected").forEach(x=>x.classList.remove("selected"));
 selected=el; el.classList.add("selected");
 feedback.textContent="Jetzt auf eine passende Beschreibung tippen.";
}

function startDrag(e,el){
 if(el.classList.contains("used")) return;
 selectTerm(el);
 const move=ev=>{
   const target=document.elementFromPoint(ev.clientX,ev.clientY)?.closest(".drop");
   document.querySelectorAll(".drop").forEach(d=>d.classList.remove("over"));
   if(target)target.classList.add("over");
 };
 const up=ev=>{
   document.removeEventListener("pointermove",move);
   document.removeEventListener("pointerup",up);
   document.querySelectorAll(".drop").forEach(d=>d.classList.remove("over"));
   const target=document.elementFromPoint(ev.clientX,ev.clientY)?.closest(".drop");
   if(target)place(el,target);
 };
 document.addEventListener("pointermove",move);
 document.addEventListener("pointerup",up);
}

function place(term,drop){
 if(drop.classList.contains("correct")) return;
 const answer=drop.dataset.answer;
 const value=term.dataset.term;
 if(value===answer){
   drop.classList.add("correct"); drop.classList.remove("wrong");
   const a=drop.querySelector(".answer"); a.textContent=value; a.classList.remove("empty");
   term.classList.remove("selected"); term.classList.add("used");
   selected=null; correct++;
   feedback.textContent=correct===data.length ? "🎉 Sehr gut! Alle Begriffe sind richtig zugeordnet." : "✓ Richtig!";
   feedback.style.color="#25824f";
   update();
 }else{
   drop.classList.add("wrong");
   feedback.textContent="✗ Noch einmal versuchen.";
   feedback.style.color="#b52f2f";
   setTimeout(()=>drop.classList.remove("wrong"),450);
 }
}

function update(){
 document.getElementById("status").textContent=`${correct} / ${data.length} richtig`;
 document.getElementById("fill").style.width=(correct/data.length*100)+"%";
}
document.getElementById("reset").onclick=render;
document.getElementById("new").onclick=render;
render();
</script>
</body>
</html>
